{
  "name": "daylight-todo",
  "version": "1.0.0",
  "description": "A calm, focused desktop todo list",
  "author": "kapustaltd",
  "homepage": "https://github.com/kapustaltd/daylight-todo",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kapustaltd.daylighttodo",
    "productName": "Daylight Todo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Office",
      "maintainer": "kapustaltd",
      "target": ["AppImage", "deb"]
    }
  }
}
